ENVIRONMENT=local
# The API takes 3000; the worker sits beside it on 3001. Cloud Run overrides
# PORT at runtime.
PORT=3001

# MongoDB — the same database the API reads. Locally this is the brew-installed
# mongod; in production it's the Atlas SRV string (include the db name).
MONGODB_URI=mongodb://localhost:27017/landscape

# Clerk webhook signing secret (whsec_… from the Clerk dashboard → Webhooks).
# Verifies inbound webhook signatures. Locally any non-empty value lets the
# worker boot; it's only actually checked when a real webhook arrives, so use a
# real secret when testing against Clerk's dashboard "Send test" feature.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_local_placeholder

# --- Production only (Cloud Tasks); unused locally, where an in-process queue
# stands in. Listed here so the deploy surface is documented in one place. ---
# GCP_PROJECT_ID=landscape-499116
# GCP_LOCATION=us-central1
# WORKER_URL=https://landscape-worker-xxxx.run.app
# TASKS_INVOKER_SERVICE_ACCOUNT=cloud-tasks-invoker@landscape-499116.iam.gserviceaccount.com

# Object storage bucket. Locally this only names the bucket; bytes go to
# .local-storage/ at the REPO ROOT via LocalObjectStorage — the API and the
# worker are started with different cwds and must share one directory.
# Override with LOCAL_STORAGE_ROOT (absolute path) if you need it elsewhere.
DOCUMENTS_BUCKET=landscape-documents-local
