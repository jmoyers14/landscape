ENVIRONMENT=local
PORT=3000
WEB_URL=http://localhost:5173

# From the Clerk dashboard → API keys (Secret key, starts with sk_)
CLERK_SECRET_KEY=sk_test_xxx

# MongoDB Atlas SRV connection string (include the db name, e.g. /landscape)
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/landscape?retryWrites=true&w=majority

# Object storage bucket. Locally this only names the bucket; bytes go to
# .local-storage/ at the REPO ROOT via LocalObjectStorage — the API and the
# worker are started with different cwds and must share one directory.
# Override with LOCAL_STORAGE_ROOT (absolute path) if you need it elsewhere.
DOCUMENTS_BUCKET=landscape-documents-local

# The worker's base URL, for local task delivery.
WORKER_URL=http://localhost:3001
